% ============================================================================
% 论文数据文件
% ----------------------------------------------------------------------------
% 每条论文是一个 BibTeX 条目，会按年份倒序显示在 /publications/ 页面。
% 替换下面这条示例即可。常用字段：
%   title / author / journal / booktitle / year / volume / number / pages / doi / url
% 可选字段（本主题支持）：
%   selected     = {true}   -> 在首页"代表性论文"中展示
%   bibtex_show  = {true}   -> 显示"BibTeX"按钮
%   abstract     = {摘要}   -> 显示"摘要"折叠块
%   preview      = {xxx.png}-> 缩略图（放在 assets/img/ 下）
%   code / pdf / html / arxiv / supp
% 作者字段中，与 site.scholar 配置的姓名一致者会被加粗显示。
% ============================================================================

@article{example2026prpd,
  title        = {（示例）基于 Swin Transformer 的 PRPD 局部放电模式识别},
  author       = {Sheng, S. Z. and 其他作者},
  journal      = {期刊名称},
  volume       = {1},
  number       = {1},
  pages        = {1--10},
  year         = {2026},
  doi          = {10.0000/example},
  bibtex_show  = {true},
  abstract     = {这是一条示例条目，用于展示论文页面的排版效果。把它替换成你自己的论文即可：修改 title、author、journal、year 等字段，或直接删除本条目后粘贴自己的 BibTeX。}
}
