source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll', '~> 4.4.1'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem 'jemoji'
end

gem 'kramdown', '>= 2.5'
gem 'kramdown-parser-gfm'

# Windows 下 Jekyll 需要时区数据（CI 在 Linux 上不需要）
gem 'tzinfo-data', platforms: [:mingw, :mswin, :x64_mingw, :jruby]
